# Set the URL of the Vercel deployment or verified custom domain before building.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Pooled PostgreSQL connection string. Required for lead capture and reports.
# Never prefix secrets with NEXT_PUBLIC_.
DATABASE_URL=
# Optional email delivery from a verified sender.
RESEND_API_KEY=
REPORT_FROM_EMAIL=
ENQUIRY_TO_EMAIL=
RETENTION_DAYS=90
# Use a strong generated secret for scheduled retention cleanup.
MAINTENANCE_TOKEN=
# Authorises the daily Vercel cleanup.
CRON_SECRET=
